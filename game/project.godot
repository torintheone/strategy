; Настройки проекта Godot для Politeconomy.

config_version=5

[application]

config/name="Politeconomy"
config/description="Глобальный политико-экономический симулятор"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.054902, 0.0705882, 0.0901961, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Politeconomy.Game"

[gui]

timers/tooltip_delay_sec=0.35

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.054902, 0.0705882, 0.0901961, 1)
